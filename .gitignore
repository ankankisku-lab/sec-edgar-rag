# Environments
.venv/
RAG/
.env

# Data: everything is ignored (large, reproducible) except the small manifests
# under data/metadata that define exactly which filings make up the corpus.
data/*
!data/metadata/
data/metadata/*
!data/metadata/companies.csv
!data/metadata/filings.csv
!data/metadata/verification.csv
# Evaluation sets and results are small and must be versioned to reproduce experiments.
!data/eval/
!data/benchmarks/
logs/*
!logs/.gitkeep

# Python
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Local caches and downloaded models (kept on D:)
.cache/
models/
tools/
